# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.env

# Streamlit secrets (never commit API keys)
.streamlit/secrets.toml

# Streamlit logs
streamlit_out.txt
streamlit_err.txt
streamlit.log
streamlit_err.log
streamlit*.log
streamlit*.txt
logs/

# Parlay log is tracked so Streamlit Cloud has accuracy data
# parlay_log.json

# Test/debug scripts and one-off QA scripts
test_*.py
inspect_pp.py
_*.py

# QA/debug screenshots — regenerated on demand, not meant to be versioned
screenshots/
qa_screenshots/
*.png

# Claude session data
.claude/

# Android build output
android/.gradle/
android/app/build/
android/build/
android/app/release/
android/local.properties

# Android release keystore (contains private key — never commit)
android/konjure-release.jks

# Generated newsletter output: markdown, HTML, social drafts and the .published-* channel
# markers all regenerate, so they stay out.
#
# Written as newsletter_out/* rather than newsletter_out/ on purpose. Git does not descend
# into an excluded DIRECTORY, so a negation for a file inside one never gets considered and
# fails silently — excluding the contents instead is what makes the rule below work at all.
newsletter_out/*

# Cards are the exception: one that went out to a channel is a record of what was claimed
# and when, so published cards are tracked by default instead of needing git add -f each
# week.
!newsletter_out/*-card-*.jpg

# Fitted ATS scale/hfa — a derived cache, refits from public data on demand.
.nfl_ats_params.json
